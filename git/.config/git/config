[user]
	name = "Sho SHIMIZU"
	email = sho.shimizu@gmail.com

[init]
	defaultBranch = main

[pull]
    rebase = true

[fetch]
    prune = true

[include]
	path = ~/.config/git/config.local

[url "git@github.com:"]
	pushInsteadOf = git://github.com/
	pushInsteadOf = https://github.com/

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[merge]
	conflictStyle = zdiff3

[alias]
	dft = -c diff.external=difft diff
