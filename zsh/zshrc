# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Increase open file descriptor limit for interactive shells
ulimit -n 65536 2>/dev/null || true

# zsh history
export HISTFILE=$HOME/.zsh_history
export HISTSIZE=100000
export SAVEHIST=100000
setopt extended_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_fcntl_lock
setopt hist_verify
setopt hist_no_store

# Directory traversal
setopt auto_cd
setopt auto_pushd

# Delete a path segment when pressing Ctrl+w
export WORDCHARS="${WORDCHARS/\/}"

# mise
eval "$(mise activate zsh)"

# sheldon
eval "$(sheldon source)"

# PATH to user installed executables
export PATH="$HOME/.local/bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

if [[ -n "${HOMEBREW_PREFIX}" ]]; then
    # coreutils
    export PATH="${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:$PATH"
    # gnu-sed
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin:$PATH"
    # grep
    export PATH="${HOMEBREW_PREFIX}/opt/grep/libexec/gnubin:$PATH"
    # gnu-tar
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-tar/libexec/gnubin:$PATH"
    # curl
    export PATH="${HOMEBREW_PREFIX}/opt/curl/bin:$PATH"
fi

# LM Studio CLI
export PATH="$PATH:$HOME/.lmstudio/bin"

# krew
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="${GOPATH}/bin:$PATH"

export GHQ_ROOT=$HOME/src

export EDITOR=hx

# Completion
# Completion scripts printed by the commands listed in
# $XDG_CONFIG_HOME/zsh/completion-generators are cached as autoloadable
# functions in fpath, so tools aren't run on every startup and each script is
# loaded only when its completion is first used. A cache is regenerated when
# the tool's resolved binary path (which includes its version for mise and
# Homebrew) changes or the binary is newer than the cache.
() {
    local -A generators
    local list="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/completion-generators"
    if [[ -r "$list" ]]; then
        local name args
        while read -r name args; do
            # Skip blank lines and comments.
            [[ -z "$name" || "$name" == '#'* ]] && continue
            generators[$name]="$name $args"
        done < "$list"
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
    [[ -d "$cache_dir" ]] || mkdir -p "$cache_dir"

    # Remove caches of tools that are no longer listed.
    local file
    for file in "$cache_dir"/_*(N); do
        (( $+generators[${${file:t}#_}] )) || rm -f "$file"
    done

    for name in ${(k)generators}; do
        local file="$cache_dir/_$name"
        if (( ! $+commands[$name] )); then
            [[ -e "$file" ]] && rm -f "$file"
            continue
        fi

        local bin="${commands[$name]:A}"
        local stamp="# Generated from $bin"
        if [[ -r "$file" && ! "$bin" -nt "$file" ]]; then
            local header=
            { read -r header; read -r header } < "$file"
            [[ "$header" == "$stamp" ]] && continue
        fi

        local script="$(${(z)generators[$name]} 2>/dev/null)"
        [[ "$script" == '#compdef '* ]] || continue
        # Keep #compdef on the first line so that compinit picks it up.
        local -a lines=("${(@f)script}")
        print -rl -- "$lines[1]" "$stamp" "${(@)lines[2,-1]}" > "$file"
    done

    fpath=("$cache_dir" $fpath)
}

autoload -Uz compinit && compinit
zstyle ':completion:*:default' menu select=2

# Alias
alias ls='ls --color=auto'
alias ll='ls -lhF --color=auto'
alias la='ls -ahF --color=auto'
alias grep='grep --color=auto'
alias k='kubectl'
alias g='git'
alias ga='git add'
alias gs='git switch'

function repo() {
    local selected="$(ghq list | fzf)"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    z "$GHQ_ROOT/$selected"
}

function repo-widget() {
    zle -I
    repo
    zle reset-prompt
}
zle -N repo-widget
bindkey '^Xp' repo-widget

function fzf-select-history() {
    local selected="$(history -n -r 1 | awk '!seen[$0]++' | fzf --scheme=history --query "$LBUFFER")"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    BUFFER="$selected"
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N fzf-select-history
bindkey '^R' fzf-select-history

# zoxide
eval "$(zoxide init zsh)"

# fzf
export FZF_DEFAULT_OPTS="--layout=reverse"

# Starship
eval "$(starship init zsh)"

# Load local only settings if available
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Remove duplicated PATH entries
typeset -U path PATH
