# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Increase open file descriptor limit for interactive shells
ulimit -n 65536 2>/dev/null || true

# zsh history
export HISTFILE=$HOME/.zsh_history
export HISTSIZE=100000
export SAVEHIST=100000
setopt extended_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_fcntl_lock
setopt hist_verify
setopt hist_no_store

# Directory traversal
setopt auto_cd
setopt auto_pushd

# Delete a path segment when pressing Ctrl+w
export WORDCHARS="${WORDCHARS/\/}"

# mise
eval "$(mise activate zsh)"

# sheldon
eval "$(sheldon source)"

# PATH to user installed executables
export PATH="$HOME/.local/bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

if [[ -n "${HOMEBREW_PREFIX}" ]]; then
    # coreutils
    export PATH="${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:$PATH"
    # gnu-sed
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin:$PATH"
    # grep
    export PATH="${HOMEBREW_PREFIX}/opt/grep/libexec/gnubin:$PATH"
    # gnu-tar
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-tar/libexec/gnubin:$PATH"
    # curl
    export PATH="${HOMEBREW_PREFIX}/opt/curl/bin:$PATH"
fi

# LM Studio CLI
export PATH="$PATH:$HOME/.lmstudio/bin"

# krew
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="${GOPATH}/bin:$PATH"

export GHQ_ROOT=$HOME/src

export EDITOR=hx

function source_completion() {
    local cmd_name="$1"
    shift

    local cmd_bin_path="${commands[$cmd_name]-}"
    if [[ -z "$cmd_bin_path" ]]; then
        return 0
    fi

    local real_bin_path="${cmd_bin_path:A}"
    if [[ -n "${commands[mise]-}" && "$real_bin_path" == "${commands[mise]:A}" ]]; then
        cmd_bin_path="$(mise which "$cmd_name" 2>/dev/null)" || return 0
        [[ -n "$cmd_bin_path" ]] || return 0
        real_bin_path="${cmd_bin_path:A}"
    fi

    zmodload zsh/stat
    local -A bin_stat
    zstat -L -H bin_stat -- "$real_bin_path" 2>/dev/null || return 0
    local fingerprint="$real_bin_path:$bin_stat[mtime]:$bin_stat[size]:$bin_stat[device]:$bin_stat[inode]"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
    local cache_path="$cache_dir/${cmd_name}.zsh"
    local stamp_path="$cache_path.stamp"
    if [[ ! -r "$cache_path" || ! -r "$stamp_path" || "$(< "$stamp_path")" != "$fingerprint" ]]; then
        mkdir -p "$cache_dir" || return 0
        local temp_path="$cache_path.$$"
        if "$cmd_bin_path" "$@" >| "$temp_path"; then
            print -r -- "$fingerprint" >| "$temp_path.stamp" || return 0
            mv "$temp_path" "$cache_path" || return 0
            mv "$temp_path.stamp" "$stamp_path" || return 0
        else
            rm -f "$temp_path"
            return 0
        fi
    fi

    source "$cache_path"
}

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*:default' menu select=2

source_completion kind completion zsh
source_completion kubectl completion zsh
source_completion gh completion -s zsh
source_completion just --completions zsh
source_completion helm completion zsh
source_completion flux completion zsh
source_completion kustomize completion zsh
source_completion stern --completion zsh
source_completion hubble completion zsh
source_completion cilium completion zsh
source_completion cue completion zsh

# Alias
alias ls='ls --color=auto'
alias ll='ls -lhF --color=auto'
alias la='ls -ahF --color=auto'
alias grep='grep --color=auto'
alias k='kubectl'
alias g='git'
alias ga='git add'
alias gs='git switch'

function repo() {
    local selected="$(ghq list | fzf)"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    z "$GHQ_ROOT/$selected"
}

function repo-widget() {
    zle -I
    repo
    zle reset-prompt
}
zle -N repo-widget
bindkey '^Xp' repo-widget

function fzf-select-history() {
    local selected="$(history -n -r 1 | awk '!seen[$0]++' | fzf --scheme=history --query "$LBUFFER")"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    BUFFER="$selected"
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N fzf-select-history
bindkey '^R' fzf-select-history

# zoxide
eval "$(zoxide init zsh)"

# fzf
export FZF_DEFAULT_OPTS="--layout=reverse"

# Starship
eval "$(starship init zsh)"

# Load local only settings if available
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Remove duplicated PATH entries
typeset -U path PATH
