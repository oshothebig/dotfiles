# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Increase open file descriptor limit for interactive shells
ulimit -n 65536 2>/dev/null || true

# zsh history
export HISTFILE=$HOME/.zsh_history
export HISTSIZE=100000
export SAVEHIST=100000
setopt extended_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_fcntl_lock
setopt hist_verify
setopt hist_no_store

# Directory traversal
setopt auto_cd
setopt auto_pushd

# Delete a path segment when pressing Ctrl+w
export WORDCHARS="${WORDCHARS/\/}"

# mise
eval "$(mise activate zsh)"

# sheldon
eval "$(sheldon source)"

# PATH to user installed executables
export PATH="$HOME/.local/bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

if [[ -n "${HOMEBREW_PREFIX}" ]]; then
    # coreutils
    export PATH="${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin:$PATH"
    # gnu-sed
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin:$PATH"
    # grep
    export PATH="${HOMEBREW_PREFIX}/opt/grep/libexec/gnubin:$PATH"
    # gnu-tar
    export PATH="${HOMEBREW_PREFIX}/opt/gnu-tar/libexec/gnubin:$PATH"
    # curl
    export PATH="${HOMEBREW_PREFIX}/opt/curl/bin:$PATH"
fi

# LM Studio CLI
export PATH="$PATH:$HOME/.lmstudio/bin"

# krew
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="${GOPATH}/bin:$PATH"

export GHQ_ROOT=$HOME/src

export EDITOR=hx

# Cache and source CLI completion scripts.
# Keyed by the resolved binary path so project-local mise version changes
# reuse or regenerate the matching script under XDG_CACHE_HOME without
# running generators on every shell start.
typeset -gA _MISE_COMPLETION_BIN
typeset -ga _MISE_COMPLETION_SPECS
_MISE_COMPLETION_SPECS=(
    'kind:kind completion zsh'
    'kubectl:kubectl completion zsh'
    'gh:gh completion -s zsh'
    'just:just --completions zsh'
    'helm:helm completion zsh'
    'flux:flux completion zsh'
    'kustomize:kustomize completion zsh'
    'stern:stern --completion zsh'
    'hubble:hubble completion zsh'
    'cilium:cilium completion zsh'
    'cue:cue completion zsh'
)

function source_cached_completion() {
    local cmd_name="$1"
    shift

    local cmd_bin_path="${commands[$cmd_name]}"
    if [[ -z "$cmd_bin_path" ]]; then
        cmd_bin_path="$(command -v "$cmd_name")"
    fi
    if [[ -z "$cmd_bin_path" ]]; then
        unset "_MISE_COMPLETION_BIN[$cmd_name]"
        return 0
    fi

    # :A → absolute path with symlinks resolved (works on macOS/Linux zsh).
    local resolved="${cmd_bin_path:A}"
    if [[ "${_MISE_COMPLETION_BIN[$cmd_name]}" == "$resolved" ]]; then
        return 0
    fi

    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions/${cmd_name}"
    if [[ ! -d "$cache_dir" ]]; then
        mkdir -p "$cache_dir"
    fi

    local cache_key="${resolved//\//_}"
    local cache_path="${cache_dir}/${cache_key}.zsh"
    if [[ ! -r "$cache_path" || "$resolved" -nt "$cache_path" ]]; then
        print -P "%F{green}Generating completion cache: ${cmd_name}%f"
        if ! "$@" >"$cache_path"; then
            rm -f "$cache_path"
            return 1
        fi
    fi

    source "$cache_path"
    _MISE_COMPLETION_BIN[$cmd_name]="$resolved"
}

function refresh_mise_tool_completions() {
    local spec cmd_name generator
    # PATH may have changed via mise hook-env; refresh $commands.
    rehash
    for spec in "${_MISE_COMPLETION_SPECS[@]}"; do
        cmd_name="${spec%%:*}"
        generator="${spec#*:}"
        # split generator into words without invoking a subshell eval of user input
        source_cached_completion "$cmd_name" ${=generator}
    done
}

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*:default' menu select=2

function _mise_tool_completions_fingerprint() {
    local spec cmd_name fingerprint=""
    for spec in "${_MISE_COMPLETION_SPECS[@]}"; do
        cmd_name="${spec%%:*}"
        fingerprint+="${commands[$cmd_name]}:"
    done
    REPLY="$fingerprint"
}

refresh_mise_tool_completions

# After mise updates PATH on cd / prompt, reload only when tool binary paths changed.
typeset -g _MISE_COMPLETION_LAST_PATH="$PATH"
_mise_tool_completions_fingerprint
typeset -g _MISE_COMPLETION_FINGERPRINT="$REPLY"
function _mise_tool_completions_precmd() {
    # Fast path: mise hook-env leaves PATH unchanged on most prompts.
    if [[ "$PATH" == "$_MISE_COMPLETION_LAST_PATH" ]]; then
        return 0
    fi
    _MISE_COMPLETION_LAST_PATH="$PATH"
    rehash
    _mise_tool_completions_fingerprint
    if [[ "$REPLY" == "$_MISE_COMPLETION_FINGERPRINT" ]]; then
        return 0
    fi
    _MISE_COMPLETION_FINGERPRINT="$REPLY"
    refresh_mise_tool_completions
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _mise_tool_completions_precmd

# Alias
alias ls='ls --color=auto'
alias ll='ls -lhF --color=auto'
alias la='ls -ahF --color=auto'
alias grep='grep --color=auto'
alias k='kubectl'
alias g='git'
alias ga='git add'
alias gs='git switch'

function repo() {
    local selected="$(ghq list | fzf)"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    z "$GHQ_ROOT/$selected"
}

function repo-widget() {
    zle -I
    repo
    zle reset-prompt
}
zle -N repo-widget
bindkey '^Xp' repo-widget

function fzf-select-history() {
    local selected="$(history -n -r 1 | awk '!seen[$0]++' | fzf --scheme=history --query "$LBUFFER")"
    if [[ -z "$selected" ]]; then
        return 0
    fi
    BUFFER="$selected"
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N fzf-select-history
bindkey '^R' fzf-select-history

# zoxide
eval "$(zoxide init zsh)"

# fzf
export FZF_DEFAULT_OPTS="--layout=reverse"

# Starship
eval "$(starship init zsh)"

# Load local only settings if available
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Remove duplicated PATH entries
typeset -U path PATH
