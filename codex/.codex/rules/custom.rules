prefix_rule(pattern=["git", ["diff", "log", "status", "show", "branch", "add", "rm", "mv"]], decision="allow")
prefix_rule(pattern=["gh", "issue", ["view", "list", "status"]], decision="allow")
prefix_rule(pattern=["gh", "label", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", ["view", "diff", "list", "checks", "status"]], decision="allow")
prefix_rule(pattern=["gh", "release", ["list", "view"]], decision="allow")
prefix_rule(pattern=["gh", "run", ["list", "view"]], decision="allow")
prefix_rule(pattern=["gh", "search", ["issues", "prs"]], decision="allow")
prefix_rule(pattern=["gh", "project", ["list", "item-list", "field-list", "view"]], decision="allow")
prefix_rule(pattern=["mkdir", "-p"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["find", "."], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["yq", "eval"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["kubectl", ["get", "describe", "explain", "api-resources", "api-versions", "version", "cluster-info", "logs", "top", "events"]], decision="allow")
prefix_rule(pattern=["terraform", ["validate", "fmt"]], decision="allow")
prefix_rule(pattern=["ansible-config", ["list", "dump", "view"]], decision="allow")
prefix_rule(pattern=["ansible", "--version"], decision="allow")
prefix_rule(pattern=["ansible-playbook", ["--version", "--list-tasks", "--list-hosts", "--list-tags", "--syntax-check"]], decision="allow")
prefix_rule(pattern=["ansible-inventory", ["--list", "--graph", "--host"]], decision="allow")
prefix_rule(pattern=["ansible-doc"], decision="allow")
